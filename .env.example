# App Config
APP_NAME="AI Video Search Engine API"
APP_ENV=development
API_VERSION=0.3.0

# Database Config
# For Docker Compose: postgresql+psycopg://postgres:postgres@postgres:5432/ai_vsg
# For local running: postgresql+psycopg://postgres:postgres@localhost:5432/ai_vsg
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_vsg
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_vsg

# Upload Settings
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=1024
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Redis Message Broker
# For Docker Compose: redis://redis:6379/0
# For local running: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector Store
# For Docker Compose: http://qdrant:6333
# For local running: http://localhost:6333
QDRANT_URL=http://localhost:6333
